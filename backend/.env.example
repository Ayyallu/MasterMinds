# Copy to .env and fill in real local values. Never commit a real .env.
# Placeholders below are intentionally non-working.

DATABASE_URL=postgresql+asyncpg://REPLACE_DB_USER:REPLACE_DB_PASSWORD@localhost:5432/REPLACE_DB_NAME
FRONTEND_ORIGIN=http://localhost:3000
HEALTH_DB_TIMEOUT_SECONDS=3.0
ENVIRONMENT=development

# Auth / security. Generate a strong value for JWT_SECRET in any shared or
# production environment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The app refuses to start in production while JWT_SECRET is a known dev default.
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# AI question generation. Defaults to the deterministic mock provider (no cost).
# Set AI_PROVIDER=nvidia and NVIDIA_API_KEY to use NVIDIA NIM. Never commit a key.
AI_PROVIDER=mock
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
AI_MAX_POOL_SIZE=50
